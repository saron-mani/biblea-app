{
  "expo": {
    "name": "biblea",
    "slug": "biblea",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/biblea-logo.png",
    "scheme": "biblea",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/biblea-logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/biblea-logo.png",
        "backgroundColor": "#fff0f5"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.saron_mani.biblea"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/biblea-logo.png",
      "display": "standalone"
    },
    "plugins": [
      "expo-router",

      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fff0f5",
          "image": "./assets/images/biblea-logo.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1e3a8d27-1f40-4a16-9701-57e9a9e76fda"
      }
    }
  }
}
