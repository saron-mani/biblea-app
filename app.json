{
  "expo": {
    "name": "biblea",
    "slug": "biblea",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/biblea-logo.png",
    "scheme": "biblea",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/biblea-logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/biblea-logo.png",
        "backgroundColor": "#fff0f5"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.saron_mani.biblea"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/biblea-logo.png",
      "display": "standalone"
    },
    "plugins": [
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "DailyQuote",
              "label": "Verse of the Day",
              "description": "Today's verse from biblea",
              "minWidth": "180dp",
              "minHeight": "180dp",
              "targetCellWidth": 3,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview/daily-quote.png",
              "updatePeriodMillis": 3600000
            }
          ]
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fff0f5",
          "image": "./assets/images/biblea-logo.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1e3a8d27-1f40-4a16-9701-57e9a9e76fda"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1e3a8d27-1f40-4a16-9701-57e9a9e76fda"
    }
  }
}
