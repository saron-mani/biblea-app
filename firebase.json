{
  "hosting": {
    "public": "preview-site",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/preview/convert",
        "destination": "/convert.html"
      },
      {
        "source": "/preview",
        "destination": "/index.html"
      },
      {
        "source": "/convert",
        "destination": "/convert.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}
